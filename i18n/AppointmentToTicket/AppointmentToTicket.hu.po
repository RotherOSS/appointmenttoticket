#. Template: AgentAppointmentEdit
msgid "Ticket Creation"
msgstr "Jegylétrehozás"

#. Template: AgentAppointmentEdit
msgid "Article is visible for customer"
msgstr "A bejegyzés látható az ügyfélnek"

#. Perl Module: Kernel/Modules/AgentAppointmentEdit.pm
msgid "No ticket creation"
msgstr "Nincs jegylétrehozás"

#. Perl Module: Kernel/Modules/AgentAppointmentEdit.pm
msgid "Could not perform validation on field dest!"
msgstr "Nem sikerült végrehajtani az ellenőrzést a cél mezőn!"

#. Perl Module: Kernel/Modules/AgentAppointmentEdit.pm
msgid "Could not perform validation on field next state!"
msgstr "Nem sikerült végrehajtani az ellenőrzést a következő állapot mezőn!"

#. Perl Module: Kernel/Modules/AgentAppointmentEdit.pm
msgid "Could not perform validation on field service!"
msgstr "Nem sikerült végrehajtani az ellenőrzést a szolgáltatás mezőn!"

#. Perl Module: Kernel/Modules/AgentAppointmentEdit.pm
msgid "Could not perform validation on field SLA!"
msgstr "Nem sikerült végrehajtani az ellenőrzést az SLA mezőn!"

#. Perl Module: Kernel/Modules/AgentAppointmentEdit.pm
msgid "Could not perform validation on field type!"
msgstr "Nem sikerült végrehajtani az ellenőrzést a típus mezőn!"

#. Perl Module: Kernel/Modules/AgentAppointmentEdit.pm
msgid "Could not perform validation on field priority!"
msgstr "Nem sikerült végrehajtani az ellenőrzést a prioritás mezőn!"

#. SysConfig
msgid ""
"Determines the next possible ticket states, after the creation of a new "
"ticket from a calendar appointment in the agent interface."
msgstr ""
"Meghatározza a következő lehetséges jegyállapotokat egy naptáridőpontból "
"származó új jegy létrehozása után az ügyintézői felületen."

#. SysConfig
msgid ""
"Dynamic fields shown in the appointment edit screen of the agent interface"
msgstr ""
"Az ügyintézői felület időpont szerkesztése képernyőjén megjelenített "
"dinamikus mezők"

#. SysConfig
msgid "Loadermodule registration for the agent interface."
msgstr "Betöltőmodul regisztráció az ügyintézői felülethez."

#. SysConfig
msgid ""
"Sets the default next state for new tickets in the AgentAppointmentEdit "
"interface."
msgstr ""
"Beállítja az új jegyek alapértelmezett következő állapotát az időpont "
"szerkesztésénél az ügyintézői felületen."

#. SysConfig
msgid ""
"Sets the default priority for new tickets in the AgentAppointmentEdit "
"interface."
msgstr ""
"Beállítja az új jegyek alapértelmezett prioritását az időpont "
"szerkesztésénél az ügyintézői felületen."
